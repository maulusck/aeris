#!/usr/bin/env bash

BASE_DIR="$(dirname "$0")/../state"
mkdir -p "$BASE_DIR"

LOG_FILE="$BASE_DIR/state.log"

# -----------------------
# mock connections (NAME DEVICE TYPE)
# -----------------------
declare -A CON_DEVICE
declare -A CON_TYPE

CONS=("eth-user" "eth-mgmt" "eth-operator")

CON_DEVICE["eth-user"]="eth0"
CON_DEVICE["eth-mgmt"]="eth1"
CON_DEVICE["eth-operator"]="eth2"

CON_TYPE["eth-user"]="ethernet"
CON_TYPE["eth-mgmt"]="ethernet"
CON_TYPE["eth-operator"]="ethernet"

# init ip state
for c in "${CONS[@]}"; do
    [[ -f "$BASE_DIR/${c}.ips" ]] || echo "0.0.0.0/0" > "$BASE_DIR/${c}.ips"
done

# -----------------------
# parse -g
# -----------------------
GET_MODE=0
FIELD=""

if [[ "$1" == "-g" ]]; then
    GET_MODE=1
    FIELD="$2"
    shift 2
fi

CMD="$1"
SUBCMD="$2"
CON_ID="$3"

# -----------------------
# con show
# -----------------------
if [[ "$CMD" =~ ^(con|connection)$ && "$SUBCMD" == "show" ]]; then

    # nmcli -g NAME,DEVICE,TYPE con show
    if [[ "$GET_MODE" -eq 1 ]]; then
        IFS=',' read -ra COLS <<< "$FIELD"

        for c in "${CONS[@]}"; do
            OUT=""

            for col in "${COLS[@]}"; do
                case "$col" in
                    NAME)   OUT+="${c}:" ;;
                    DEVICE) OUT+="${CON_DEVICE[$c]}:" ;;
                    TYPE)   OUT+="${CON_TYPE[$c]}:" ;;
                    *)
                        OUT+="unknown:"
                        ;;
                esac
            done

            echo "${OUT%:}"
        done

        exit 0
    fi

    # nmcli con show <name>
    if [[ -n "$CON_ID" ]]; then
        if [[ ! " ${CONS[*]} " =~ " $CON_ID " ]]; then
            echo "Error: unknown connection $CON_ID" >&2
            exit 10
        fi
        echo "$CON_ID"
        exit 0
    fi

    # nmcli con show
    for c in "${CONS[@]}"; do
        echo "$c"
    done
    exit 0
fi

# -----------------------
# con modify
# -----------------------
if [[ "$CMD" =~ ^(con|connection)$ && "$SUBCMD" =~ ^(mod|modify)$ ]]; then

    if [[ ! " ${CONS[*]} " =~ " $CON_ID " ]]; then
        echo "Error: unknown connection $CON_ID" >&2
        exit 10
    fi

    FIELD="$4"
    VALUE="$5"

    FILE="$BASE_DIR/${CON_ID}.ips"

    if [[ "$FIELD" == "ipv4.addresses" ]]; then
        VALUE="${VALUE%\"}"
        VALUE="${VALUE#\"}"
        VALUE="${VALUE// /,}"
        VALUE="${VALUE//|/,}"
        echo "$VALUE" > "$FILE"
        exit 0
    fi

    echo "Error: unsupported field $FIELD" >&2
    exit 1
fi

# -----------------------
# con up (no-op)
# -----------------------
if [[ "$CMD" =~ ^(con|connection)$ && "$SUBCMD" == "up" ]]; then
    exit 0
fi

echo "nmcli mock: unsupported args: $@" >&2
exit 1