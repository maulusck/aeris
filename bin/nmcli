#!/usr/bin/env bash

mkdir -p "$(dirname "$0")/../state"
STATE_FILE="$(dirname "$0")/../state/ips.txt"
LOG_FILE="$(dirname "$0")/../state/state.log"
CON_ID_EXPECTED="eth-operator"

# init default state
[[ -f "$STATE_FILE" ]] || echo "192.168.1.10/24,10.0.0.5/24" > "$STATE_FILE"

# -----------------------
# parse -g
# -----------------------
GET_MODE=0
FIELD=""

if [[ "$1" == "-g" ]]; then
    GET_MODE=1
    FIELD="$2"
    shift 2
fi

CMD="$1"
SUBCMD="$2"
CON_ID="$3"

# -----------------------
# con show
# -----------------------
if [[ "$CMD" =~ ^(con|connection)$ && "$SUBCMD" == "show" ]]; then
    if [[ "$CON_ID" != "$CON_ID_EXPECTED" ]]; then
        echo "Error: unknown connection $CON_ID" >&2
        exit 10
    fi

    if [[ "$GET_MODE" -eq 1 && "$FIELD" == "ipv4.addresses" ]]; then
        cat "$STATE_FILE"
        exit 0
    fi

    # fallback (not really needed for your use case)
    echo "ipv4.addresses: $(cat "$STATE_FILE")"
    exit 0
fi

# -----------------------
# con modify
# -----------------------
if [[ "$CMD" =~ ^(con|connection)$ && "$SUBCMD" =~ ^(mod|modify)$ ]]; then
    if [[ "$CON_ID" != "$CON_ID_EXPECTED" ]]; then
        echo "Error: unknown connection $CON_ID" >&2
        exit 10
    fi

    FIELD="$4"
    VALUE="$5"

    if [[ "$FIELD" == "ipv4.addresses" ]]; then
        VALUE="${VALUE%\"}"
        VALUE="${VALUE#\"}"

        # normalize to comma-separated (what your Python expects)
        VALUE="${VALUE// /,}"
        VALUE="${VALUE//|/,}"

        echo "$VALUE" > "$STATE_FILE"
        exit 0
    fi

    echo "Error: unsupported field $FIELD" >&2
    exit 1
fi

# -----------------------
# con up (no-op)
# -----------------------
if [[ "$CMD" =~ ^(con|connection)$ && "$SUBCMD" == "up" ]]; then
    exit 0
fi

# -----------------------
# fallback
# -----------------------
echo "nmcli mock: unsupported args: $@" >&2
exit 1